{
  "name": "robinhood-for-agents",
  "version": "2.0.0",
  "type": "module",
  "description": "AI-native Robinhood trading interface — MCP server + TypeScript client",
  "license": "MIT",
  "author": "Kevin Chun",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevin1chun/robinhood-for-agents.git"
  },
  "homepage": "https://github.com/kevin1chun/robinhood-for-agents#readme",
  "bugs": "https://github.com/kevin1chun/robinhood-for-agents/issues",
  "keywords": [
    "robinhood",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "trading",
    "api-client",
    "typescript",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "robinhood-for-agents": "./dist/bin/robinhood-for-agents.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    }
  },
  "files": ["dist", "skills", "docs"],
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.50.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "onboard": "bun bin/robinhood-for-agents.ts onboard",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bun test __tests__/integration/",
    "pnl:harness": "bun scripts/pnl-oracle-harness.ts"
  },
  "overrides": {
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
